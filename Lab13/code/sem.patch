## applied on top of Lab 10 (which already added SYS_trace = 23)

--- a/kernel/syscall.h
+++ b/kernel/syscall.h
@@ -22,3 +22,6 @@
 #define SYS_sync   22
 #define SYS_trace        23       // new
+#define SYS_sem_init    24       // Lab 13
+#define SYS_sem_down    25       // Lab 13
+#define SYS_sem_up      26       // Lab 13

--- a/user/user.h
+++ b/user/user.h
@@ -28,3 +28,6 @@
 int trace(int);                // new
+int sem_init(int, int);         // Lab 13: sem_init(idx, value)
+int sem_down(int);              // Lab 13: P (wait)
+int sem_up(int);                // Lab 13: V (signal)

--- a/user/usys.pl
+++ b/user/usys.pl
@@ -43,0 +44,3 @@
 entry("trace");                # new
+entry("sem_init");             # Lab 13
